{
  "name": "@fiatlux/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@fiatlux/contracts": "workspace:*",
    "@fiatlux/db": "workspace:*",
    "@fiatlux/domain": "workspace:*",
    "@fiatlux/integrations": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
