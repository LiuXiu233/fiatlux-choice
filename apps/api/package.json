{
  "name": "@fiatlux/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism --maxWorkers=1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "10.2.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fiatlux/contracts": "workspace:*",
    "@fiatlux/db": "workspace:*",
    "@fiatlux/domain": "workspace:*",
    "@fiatlux/integrations": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
