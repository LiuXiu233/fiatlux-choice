{
  "name": "@fiatlux/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "10.2.4",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@fiatlux/contracts": "workspace:*",
    "@fiatlux/db": "workspace:*",
    "@fiatlux/domain": "workspace:*",
    "@fiatlux/integrations": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
