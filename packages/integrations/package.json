{
  "name": "@fiatlux/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/integrations.test.ts",
    "test:integration": "vitest run test/storage.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@fiatlux/contracts": "workspace:*",
    "pg-boss": "^10.3.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
