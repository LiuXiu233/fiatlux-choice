{
  "name": "@fiatlux/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "development": "./src/seed.ts",
      "import": "./dist/seed.js",
      "default": "./dist/seed.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed-cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run test"
  },
  "dependencies": {
    "@fiatlux/contracts": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
