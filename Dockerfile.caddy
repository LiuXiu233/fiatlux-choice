# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine AS caddy-build

ARG TARGETOS
ARG TARGETARCH
ARG CADDY_VERSION=v2.11.4
RUN --mount=type=cache,id=caddy-go-mod,target=/go/pkg/mod,sharing=shared \
    --mount=type=cache,id=caddy-go-build-${TARGETOS}-${TARGETARCH},target=/root/.cache/go-build,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
      go install -trimpath \
        -ldflags="-X github.com/caddyserver/caddy/v2.CustomVersion=${CADDY_VERSION}" \
        "github.com/caddyserver/caddy/v2/cmd/caddy@${CADDY_VERSION}"; \
    if [ "$TARGETOS/$TARGETARCH" = "$(go env GOHOSTOS)/$(go env GOHOSTARCH)" ]; then \
      src=/go/bin/caddy; \
    else \
      src="/go/bin/${TARGETOS}_${TARGETARCH}/caddy"; \
    fi; \
    mkdir -p /out; \
    cp "$src" /out/caddy; \
    test -s /out/caddy

FROM alpine:3.23

ENV HOME=/tmp \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data

RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates && \
    addgroup -S -g 10001 fiatlux && \
    adduser -S -D -H -u 10001 -G fiatlux fiatlux && \
    mkdir -p /data/caddy /config/caddy && \
    chown -R 10001:10001 /data /config

COPY --from=caddy-build /out/caddy /usr/bin/caddy
COPY --chown=10001:10001 infra/caddy/Caddyfile.dev /etc/caddy/Caddyfile.dev
COPY --chown=10001:10001 infra/caddy/Caddyfile.prod /etc/caddy/Caddyfile.prod

USER 10001:10001
EXPOSE 8080 8443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile.prod", "--adapter", "caddyfile"]
