{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "datasetId": {
      "$ref": "#/$defs/__schema1"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["internal_draft", "in_review", "approved"]
    },
    "audience": {
      "type": "string",
      "minLength": 4,
      "maxLength": 200
    },
    "scope": {
      "$ref": "#/$defs/__schema2"
    },
    "lastUpdatedAt": {
      "$ref": "#/$defs/__schema3"
    },
    "nextReviewAt": {
      "$ref": "#/$defs/__schema3"
    },
    "maintenanceOwnerRole": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "publicationBoundary": {
      "$ref": "#/$defs/__schema2"
    },
    "references": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "articles": {
      "minItems": 4,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "datasetId",
    "title",
    "status",
    "audience",
    "scope",
    "lastUpdatedAt",
    "nextReviewAt",
    "maintenanceOwnerRole",
    "publicationBoundary",
    "references",
    "articles"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4000
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "kind": {
          "type": "string",
          "enum": ["official", "internal"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "authority": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "location": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "publishedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastVerifiedAt": {
          "$ref": "#/$defs/__schema3"
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "pending", "reviewed"]
        },
        "applicability": {
          "$ref": "#/$defs/__schema2"
        },
        "usageBoundary": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "authority",
        "location",
        "publishedAt",
        "lastVerifiedAt",
        "reviewStatus",
        "applicability",
        "usageBoundary"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "slug": {
          "$ref": "#/$defs/__schema1"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "version": {
          "$ref": "#/$defs/__schema0"
        },
        "audience": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "applicability": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "nonPromises": {
          "minItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "safetyNotes": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "learningObjectives": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pending", "in_review", "changes_requested", "reviewed"]
            },
            "ownerRole": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "reviewerRoles": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema6"
              }
            },
            "lastReviewedAt": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextReviewAt": {
              "$ref": "#/$defs/__schema3"
            },
            "note": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "status",
            "ownerRole",
            "reviewerRoles",
            "lastReviewedAt",
            "nextReviewAt",
            "note"
          ],
          "additionalProperties": false
        },
        "rights": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pending_clearance", "cleared", "restricted"]
            },
            "basis": {
              "$ref": "#/$defs/__schema2"
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          "required": ["status", "basis", "evidenceRefs"],
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not_published",
                "approved_for_manual_publication",
                "published_with_evidence"
              ]
            },
            "targetChannel": {
              "type": "string",
              "enum": ["fiatlux_gg_wordpress"]
            },
            "externalStateLabel": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "evidenceUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publishedAt": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema3"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manualBoundary": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "status",
            "targetChannel",
            "externalStateLabel",
            "evidenceUrl",
            "publishedAt",
            "manualBoundary"
          ],
          "additionalProperties": false
        },
        "aiDisclosure": {
          "type": "object",
          "properties": {
            "assisted": {
              "type": "boolean",
              "const": true
            },
            "disclosure": {
              "$ref": "#/$defs/__schema2"
            },
            "humanReviewRequired": {
              "type": "boolean",
              "const": true
            },
            "prohibitedUses": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": ["assisted", "disclosure", "humanReviewRequired", "prohibitedUses"],
          "additionalProperties": false
        },
        "sourceRefs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "sections": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "template": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            },
            "instructions": {
              "$ref": "#/$defs/__schema2"
            },
            "fields": {
              "minItems": 4,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "completionRule": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": ["title", "instructions", "fields", "completionRule"],
          "additionalProperties": false
        },
        "practice": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            },
            "scenario": {
              "$ref": "#/$defs/__schema2"
            },
            "steps": {
              "minItems": 3,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "deliverable": {
              "$ref": "#/$defs/__schema2"
            },
            "selfCheck": {
              "minItems": 3,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": ["title", "scenario", "steps", "deliverable", "selfCheck"],
          "additionalProperties": false
        },
        "reviewQuestions": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "summary",
        "version",
        "audience",
        "applicability",
        "nonPromises",
        "safetyNotes",
        "learningObjectives",
        "review",
        "rights",
        "publication",
        "aiDisclosure",
        "sourceRefs",
        "sections",
        "template",
        "practice",
        "reviewQuestions"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "paragraphs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "example": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "text": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": ["label", "text"],
          "additionalProperties": false
        }
      },
      "required": ["heading", "paragraphs"],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "guidance": {
          "$ref": "#/$defs/__schema2"
        },
        "example": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["label", "guidance", "example"],
      "additionalProperties": false
    }
  },
  "$id": "https://fiatlux.gg/schemas/education-content.schema.json",
  "title": "FIAT LUX 电竞教育内容包",
  "description": "版本化电竞教育文章、人工复核、素材权利、发布边界、来源、AI 披露、练习与模板的结构约束；跨记录语义约束由 TypeScript 校验器补充执行。"
}
