# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine AS minio-build

ARG TARGETOS
ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z

RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch "$MINIO_RELEASE" https://github.com/minio/minio.git .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go get \
      github.com/apache/thrift@v0.23.0 \
      github.com/buger/jsonparser@v1.1.2 \
      github.com/go-jose/go-jose/v4@v4.1.4 \
      github.com/prometheus/prometheus@v0.311.3 \
      go.opentelemetry.io/otel/sdk@v1.43.0 \
      go.opentelemetry.io/otel/sdk/metric@v1.43.0 \
      golang.org/x/crypto@v0.52.0 \
      golang.org/x/net@v0.55.0 \
      google.golang.org/grpc@v1.81.0
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && \
    LDFLAGS="$(go run buildscripts/gen-ldflags.go)" && \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
      go build -mod=mod -tags kqueue -trimpath -ldflags "$LDFLAGS" -o /out/minio .

FROM --platform=$BUILDPLATFORM golang:1.27.0-alpine AS mc-build

ARG TARGETOS
ARG TARGETARCH
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z

RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch "$MC_RELEASE" https://github.com/minio/mc.git .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go get \
      github.com/prometheus/prometheus@v0.311.3 \
      golang.org/x/crypto@v0.52.0 \
      golang.org/x/net@v0.55.0 \
      google.golang.org/grpc@v1.81.0
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out && \
    LDFLAGS="$(go run buildscripts/gen-ldflags.go)" && \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
      go build -mod=mod -tags kqueue -trimpath -ldflags "$LDFLAGS" -o /out/mc .

FROM alpine:3.23

RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates && \
    mkdir -p /data && \
    chown 1000:1000 /data

COPY --from=minio-build /out/minio /usr/bin/minio
COPY --from=mc-build /out/mc /usr/bin/mc
COPY --from=minio-build /src/CREDITS /licenses/CREDITS
COPY --from=minio-build /src/LICENSE /licenses/LICENSE

ENV HOME=/tmp \
    MC_CONFIG_DIR=/tmp/.mc \
    MINIO_CONFIG_ENV_FILE=config.env

USER 1000:1000
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
