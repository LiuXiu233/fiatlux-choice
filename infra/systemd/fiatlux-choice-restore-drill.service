[Unit]
Description=FIAT LUX CHOICE isolated restore drill
Requires=docker.service
After=docker.service fiatlux-choice-backup.service

[Service]
Type=oneshot
User=fiatlux
Group=fiatlux
SupplementaryGroups=docker
WorkingDirectory=/opt/fiatlux-choice
Environment=FIATLUX_ENV=production
Environment=FIATLUX_ENV_FILE=/etc/fiatlux-choice/production.env
EnvironmentFile=/etc/fiatlux-choice/production.env
ExecStart=/opt/fiatlux-choice/scripts/restore-latest-drill.sh
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/var/backups/fiatlux-choice
