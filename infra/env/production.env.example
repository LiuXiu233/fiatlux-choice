# Copy to /etc/fiatlux-choice/production.env with mode 0600. Never commit the real file.
APP_IMAGE_TAG=v1.0.0
IMAGE_PREFIX=ghcr.io/liuxiu233/fiatlux-choice

# Internal DNS and listener. Keep the application off the public Internet.
APP_DOMAIN=choice.internal.example
BIND_ADDRESS=192.0.2.10
HTTPS_PORT=8443

POSTGRES_DB=fiatlux_choice
POSTGRES_USER=fiatlux
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_HEX

MINIO_ROOT_USER=fiatlux
MINIO_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_HEX
S3_BUCKET=fiatlux-choice
S3_REGION=cn-south-1

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_HOURS=12
JWT_TTL_SECONDS=43200
INITIAL_ADMIN_EMAIL=admin@fiatlux.local
INITIAL_ADMIN_PASSWORD=REPLACE_BEFORE_FIRST_START

LLM_DRIVER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GITHUB_INTEGRATION_MODE=manual
GITHUB_TOKEN=
LOG_LEVEL=info

# The age recipient is public. Keep the matching identity offline and access-controlled.
BACKUP_DIR=/var/backups/fiatlux-choice
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/etc/fiatlux-choice/age-identity.txt
BACKUP_REQUIRE_ENCRYPTION=true

# Used by upgrade/rollback post-deployment verification.
CADDY_ROOT_CA_FILE=/etc/fiatlux-choice/caddy-root.crt
