# Copy to /etc/fiatlux-choice/production.env with mode 0600. Never commit the real file.
APP_IMAGE_TAG=v1.0.0
IMAGE_PREFIX=ghcr.io/liuxiu233/fiatlux-choice

# Internal DNS and listener. Keep the application off the public Internet.
APP_DOMAIN=choice.internal.example
BIND_ADDRESS=192.0.2.10
HTTPS_PORT=8443

POSTGRES_DB=fiatlux_choice
# Only PostgreSQL itself and the explicit one-shot db-bootstrap operation receive the bootstrap
# identity. API/worker receive fiatlux_runtime; migrate/queue-migrate use fiatlux_migrator;
# backup/restore credentials are mounted only into their explicit operations.
POSTGRES_BOOTSTRAP_USER=fiatlux_bootstrap
# During bootstrap password rotation only, inject the old value transiently through the shell as
# POSTGRES_BOOTSTRAP_CURRENT_PASSWORD. Do not keep the old value in this long-lived file.
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
POSTGRES_BACKUP_PASSWORD=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
POSTGRES_RESTORE_PASSWORD=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
# API and worker each use one Drizzle pool and one pg-boss pool. This limit applies per pool, so the
# default aggregate ceiling is 20 lazy connections. Do not raise it merely to hide failures;
# investigate PostgreSQL sessions and host pressure first.
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Cooperative `/health/ready` deadline; deployment curl retains an external hard timeout.
# A hung dependency probe stays single-flight instead of accumulating more probes.
READINESS_TIMEOUT_MS=3000

MINIO_ROOT_USER=fiatlux
MINIO_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_HEX
S3_BUCKET=fiatlux-choice
S3_REGION=cn-south-1
# Stable access-key IDs with independently rotated secrets. The one-shot MinIO bootstrap attaches
# bucket-scoped app read/write, backup read-only and restore read/write policies respectively.
S3_ACCESS_KEY_ID=fiatlux-app
S3_SECRET_ACCESS_KEY=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
S3_BACKUP_ACCESS_KEY_ID=fiatlux-backup
S3_BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX
S3_RESTORE_ACCESS_KEY_ID=fiatlux-restore
S3_RESTORE_SECRET_ACCESS_KEY=REPLACE_WITH_INDEPENDENT_URL_SAFE_RANDOM_HEX

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL_HOURS=12
JWT_TTL_SECONDS=43200
# Do not persist SEED_MODE in this long-lived file. Supply it only to the reviewed one-off seed
# command; an omitted mode intentionally fails closed.
# Optional one-off override; blank uses the versioned official-source catalog in the image.
COMPLIANCE_SOURCES_FILE=
INITIAL_ADMIN_EMAIL=admin@fiatlux.local
# Only the explicit one-shot seed service receives this value. Clear it immediately after the
# owner changes the bootstrap password; routine API/worker containers never receive it.
INITIAL_ADMIN_PASSWORD=REPLACE_ONLY_DURING_FIRST_SEED

LLM_DRIVER=mock
# compatible 模式只接受经批准的 HTTPS 地址；生产环境不存在 HTTP 环回例外。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GITHUB_INTEGRATION_MODE=manual
GITHUB_TOKEN=
LOG_LEVEL=info

# The age recipient is public. Keep the matching identity offline and access-controlled.
BACKUP_DIR=/var/backups/fiatlux-choice
# Approved restore archives are mounted read-only at restore time.  The default
# pre-restore output must be a separate protected writable volume; never point it
# at a read-only import/removable-media directory.
RESTORE_SOURCE_DIR=/var/backups/fiatlux-choice
RESTORE_PRE_BACKUP_DIR=/var/lib/fiatlux-choice/pre-restore-backups
RESTORE_DRILL_REPORT_DIR=/var/lib/fiatlux-choice/restore-drill-reports
# Stable deployment identity embedded into formatVersion=2 backup metadata and required at restore.
BACKUP_SOURCE_ID=fiatlux-choice-prod-guangzhou
BACKUP_SCRATCH_DIR=/var/lib/fiatlux-choice/backup-scratch
RESTORE_SCRATCH_DIR=/var/lib/fiatlux-choice/restore-scratch
FIATLUX_MAINTENANCE_DIR=/var/lib/fiatlux-choice/maintenance
# Update this approved value when the backup release changes; a stale value makes drills fail closed.
RESTORE_EXPECTED_BACKUP_TOOL_RELEASE=v1.0.0
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/etc/fiatlux-choice/age-identity.txt
BACKUP_REQUIRE_ENCRYPTION=true
# Ed25519 private key: deployment owner only, exact mode 0400/0600, never commit or place in BACKUP_DIR.
# backup.sh validates it on the host and sends it only through stdin to each one-shot backup container.
BACKUP_SIGNING_PRIVATE_KEY_FILE=/etc/fiatlux-choice/backup-signing-private.pem
# The public key may be readable by the restore operator. Approve its DER SHA-256 through a channel
# independent from the writable backup media; restore and restore drills fail closed on mismatch.
BACKUP_SIGNING_PUBLIC_KEY_FILE=/etc/fiatlux-choice/backup-signing-public.pem
BACKUP_SIGNING_PUBLIC_KEY_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_FROM_INDEPENDENT_APPROVAL
BACKUP_REQUIRE_SIGNATURE=true
# Root-owned, backup-directory-independent manifests copied only after human approval.
BACKUP_APPROVED_MANIFEST_DIR=/etc/fiatlux-choice/approved-backups

# Used by upgrade/rollback post-deployment verification.
CADDY_ROOT_CA_FILE=/etc/fiatlux-choice/caddy-root.crt
