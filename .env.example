NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=3000
# Compose separates the cluster bootstrap, migration owner, application runtime, backup and
# restore identities. Use independent URL-safe values; examples below are development-only.
POSTGRES_DB=fiatlux_choice
POSTGRES_BOOTSTRAP_USER=fiatlux_bootstrap
# For an existing-volume bootstrap password rotation, inject the old value transiently as
# POSTGRES_BOOTSTRAP_CURRENT_PASSWORD; do not keep it in this file.
POSTGRES_BOOTSTRAP_PASSWORD=change-dev-bootstrap-password
POSTGRES_MIGRATION_PASSWORD=change-dev-migration-password
POSTGRES_RUNTIME_PASSWORD=change-dev-runtime-password
POSTGRES_BACKUP_PASSWORD=change-dev-backup-password
POSTGRES_RESTORE_PASSWORD=change-dev-restore-password
# Used only when running Node processes directly against a separately exposed local PostgreSQL.
DATABASE_URL=postgresql://fiatlux_runtime:change-dev-runtime-password@localhost:5432/fiatlux_choice
# API and worker each use one Drizzle pool and one pg-boss pool; this limit applies per pool. The
# readiness setting is an application-level cooperative deadline; deployment curl is the hard stop.
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_MS=3000
# Per-organization cap for the daily official-source sweep. The current 73-source catalog is
# initially spread over seven daily buckets; 12 leaves capacity to finish that baseline in-cycle.
COMPLIANCE_MONITOR_SWEEP_BATCH_SIZE=12
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
# TOTP secrets are encrypted with a distinct 32-byte unpadded Base64url key. Generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MFA_ENCRYPTION_KEY=replace-with-an-unpadded-32-byte-base64url-key
MFA_ENCRYPTION_KEY_ID=production-v1
# Production defaults to owner,admin; an empty value is suitable only for local/test stacks.
MFA_REQUIRED_ROLES=owner,admin
MFA_CHALLENGE_TTL_SECONDS=180
MFA_SETUP_TTL_SECONDS=900
# Do not persist SEED_MODE here. Pass bootstrap, metadata-only or system-role-maintenance only to
# the corresponding one-off command; an omitted mode must fail closed.
# Optional one-off override; blank uses the versioned official-source catalog in the image.
COMPLIANCE_SOURCES_FILE=
INITIAL_ADMIN_EMAIL=admin@fiatlux.local
INITIAL_ADMIN_PASSWORD=replace-before-first-start
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=cn-south-1
S3_BUCKET=fiatlux-choice
# MinIO server administration is confined to the server and one-shot bootstrap container.
MINIO_ROOT_USER=fiatlux-root
MINIO_ROOT_PASSWORD=replace-with-an-independent-root-secret
# API object access; never reuse MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY_ID=fiatlux-app
S3_SECRET_ACCESS_KEY=replace-with-an-independent-app-secret
# Read-only backup identity and destructive restore identity remain separate.
S3_BACKUP_ACCESS_KEY_ID=fiatlux-backup
S3_BACKUP_SECRET_ACCESS_KEY=replace-with-an-independent-backup-secret
S3_RESTORE_ACCESS_KEY_ID=fiatlux-restore
S3_RESTORE_SECRET_ACCESS_KEY=replace-with-an-independent-restore-secret
S3_FORCE_PATH_STYLE=true
LLM_DRIVER=mock
# compatible mode requires an approved HTTPS endpoint; HTTP loopback is not an exception.
LLM_BASE_URL=
# Stable, non-secret identity written to model-call audit records. Do not use mock/simulated labels.
LLM_PROVIDER_ID=openai-compatible
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=2048
GITHUB_INTEGRATION_MODE=manual
GITHUB_TOKEN=
# Required with read_only; the worker probe must authenticate and bind an approved owner/repository.
GITHUB_PROBE_REPOSITORY=
LOG_LEVEL=info
TRUST_PROXY=false
