{
  "name": "fiatlux-choice",
  "version": "0.1.0",
  "private": true,
  "description": "FIAT LUX CHOICE - 耀光电竞小团队公司治理与运营平台",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:shell": "find scripts infra -type f -name '*.sh' -print0 | xargs -0 shellcheck -x",
    "lint:fix": "biome check --write .",
    "content:education:schema": "tsx scripts/generate-education-content-schema.ts",
    "content:education:validate": "pnpm --filter @fiatlux/web exec vitest run src/lib/education-content.test.ts",
    "delivery:v1:validate": "tsx scripts/verify-v1-release-readiness.ts --validate-only",
    "delivery:v1:status": "tsx scripts/verify-v1-release-readiness.ts --json",
    "delivery:v1:require-ready": "tsx scripts/verify-v1-release-readiness.ts --require-ready",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:database-privileges": "./scripts/test-database-privileges.sh",
    "test:database-migrations": "pnpm --filter @fiatlux/db test:migrations",
    "test:e2e": "pnpm test:e2e:mock",
    "test:e2e:mock": "pnpm --filter @fiatlux/web test:e2e:mock",
    "test:e2e:real": "./scripts/e2e-real-stack.sh",
    "check": "pnpm delivery:v1:validate && pnpm lint && pnpm lint:shell && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @fiatlux/db db:generate",
    "db:migrate": "pnpm --filter @fiatlux/db db:migrate",
    "db:seed": "pnpm --filter @fiatlux/db db:seed",
    "infra:up": "./scripts/compose.sh up -d --build",
    "infra:down": "./scripts/compose.sh down",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
