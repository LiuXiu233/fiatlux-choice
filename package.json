{
  "name": "fiatlux-choice",
  "version": "0.1.0",
  "private": true,
  "description": "FIAT LUX CHOICE - 耀光电竞小团队公司治理与运营平台",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter @fiatlux/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @fiatlux/db db:generate",
    "db:migrate": "pnpm --filter @fiatlux/db db:migrate",
    "db:seed": "pnpm --filter @fiatlux/db db:seed",
    "infra:up": "./scripts/compose.sh up -d --build",
    "infra:down": "./scripts/compose.sh down",
    "backup": "./scripts/backup.sh",
    "restore": "./scripts/restore.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.1.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
